# ─── Site ──────────────────────────────────────────────────────────────
# URL publique (OG, canonical, sitemap, liens des e-mails). Par défaut : https://kraken.hustlerlabs.tech
NEXT_PUBLIC_SITE_URL=https://kraken.hustlerlabs.tech
BETTER_AUTH_URL=https://kraken.hustlerlabs.tech

# ─── Base de données (Neon PostgreSQL) ─────────────────────────────────
# URL poolée (application) et URL directe (migrations Prisma)
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/kraken?sslmode=require
DIRECT_URL=postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/kraken?sslmode=require

# ─── Sécurité ──────────────────────────────────────────────────────────
# Générer chaque secret avec : openssl rand -base64 32
BETTER_AUTH_SECRET=
# 32 octets en base64 (chiffrement AES-256-GCM des clés de test)
KEYS_ENCRYPTION_KEY=
# Sel des empreintes d'IP : openssl rand -hex 16
IP_HASH_SALT=
# Protège /api/cron/reconcile (tâche planifiée)
CRON_SECRET=

# Adresse secrète de connexion de l'équipe (8 à 64 caractères : lettres, chiffres, - et _).
# Ex. : ADMIN_PATH=console-$(openssl rand -hex 6)  →  https://kraken.hustlerlabs.tech/console-xxxxxxxxxxxx
# /admin/connexion et /admin sans session répondent alors 404.
ADMIN_PATH=

# ─── Anti-robot (Cloudflare Turnstile) ─────────────────────────────────
# Dashboard Cloudflare → Turnstile → Add widget (mode Managed, domaine kraken.hustlerlabs.tech)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ─── Premier administrateur (pnpm db:seed) ──────────────────────────
FIRST_ADMIN_EMAIL=kraken@hustlerlabs.tech
# 12 caractères minimum. Laisser vide pour le définir via « Mot de passe oublié ».
FIRST_ADMIN_PASSWORD=

# ─── E-mails (Brevo) ───────────────────────────────────────────────────
BREVO_API_KEY=
EMAIL_FROM_NAME=Kraken
EMAIL_FROM_ADDRESS=kraken@hustlerlabs.tech
# EMAIL_REPLY_TO=kraken@hustlerlabs.tech

# ─── Paiement (FeexPay) ────────────────────────────────────────────────
# live | sandbox | mock (mock = simulation locale, aucun encaissement)
FEEXPAY_MODE=live
FEEXPAY_API_KEY=
FEEXPAY_SHOP_ID=
# Valeur de l'en-tête Authorization définie dans le dashboard FeexPay (type Bearer)
FEEXPAY_WEBHOOK_SECRET=

# ─── Notifications push (Web Push / VAPID) ─────────────────────────────
# Générer : pnpm dlx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:kraken@hustlerlabs.tech

# ─── Facultatif ────────────────────────────────────────────────────────
# Jeton GitHub (lecture publique) pour éviter la limite de l'API lors de la vérification des comptes
GITHUB_TOKEN=
