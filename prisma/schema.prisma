// Schéma Kraken : Sold Out
// - Modèles d'authentification : better-auth (core + admin + two-factor + rate limit)
// - Modèles métier : participants, consentements, paiements FeexPay, e-mails, push, audit

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Authentification (better-auth) ────────────────────────────────────────────

model User {
  id               String    @id
  name             String
  email            String    @unique
  emailVerified    Boolean   @default(false)
  image            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  // plugin admin : "admin" | "moderator" | "participant"
  role             String?   @default("participant")
  banned           Boolean?  @default(false)
  banReason        String?
  banExpires       DateTime?
  // plugin two-factor
  twoFactorEnabled Boolean?  @default(false)

  sessions          Session[]
  accounts          Account[]
  twoFactors        TwoFactor[]
  participant       Participant?
  pushSubscriptions PushSubscription[]
  notes             Note[]
  auditLogs         AuditLog[]

  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  impersonatedBy String?
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model TwoFactor {
  id                      String    @id
  secret                  String
  backupCodes             String
  userId                  String
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime?
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([secret])
  @@index([userId])
  @@map("twoFactor")
}

model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rateLimit")
}

// ─── Métier ─────────────────────────────────────────────────────────────────────

enum ParticipantStatus {
  pre_registered
  email_confirmed
  payment_pending
  registered
  waitlisted
  withdrawn
  delivered
  evaluated
  disqualified
}

enum Level {
  etudiant
  junior
  confirme
  senior
}

model Participant {
  id                 String            @id @default(cuid())
  userId             String            @unique
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName           String
  email              String            @unique
  phone              String            @unique
  country            String
  city               String
  githubLogin        String            @unique
  githubId           Int?
  level              Level
  language           String?
  referral           String?
  publicName         Boolean           @default(false)
  status             ParticipantStatus @default(pre_registered)
  /// Clés de test KrakenPay chiffrées (AES-256-GCM)
  testKeyEnc         String?
  webhookSecretEnc   String?
  keysIssuedAt       DateTime?
  registrationIpHash String?
  registeredAt       DateTime?
  waitlistedAt       DateTime?
  withdrawnAt        DateTime?
  disqualifiedReason String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  consents  Consent[]
  payments  Payment[]
  emailLogs EmailLog[]
  notes     Note[]

  @@index([status])
  @@index([country])
  @@index([createdAt])
}

enum ConsentKind {
  rules
  terms
  data
  public_name
}

model Consent {
  id            String      @id @default(cuid())
  participantId String
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  kind          ConsentKind
  version       String
  acceptedAt    DateTime    @default(now())

  @@unique([participantId, kind])
}

enum PaymentStatus {
  pending
  succeeded
  failed
  refunded
}

model Payment {
  id             String        @id @default(cuid())
  participantId  String
  participant    Participant   @relation(fields: [participantId], references: [id], onDelete: Cascade)
  amount         Int
  currency       String        @default("XOF")
  network        String
  phone          String
  status         PaymentStatus @default(pending)
  /// Référence FeexPay (reference / order_id)
  providerRef    String?       @unique
  idempotencyKey String        @unique
  failureReason  String?
  lastCheckedAt  DateTime?
  confirmedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([participantId, status])
  @@index([status, createdAt])
}

enum EmailStatus {
  sent
  failed
  skipped
}

model EmailLog {
  id            String       @id @default(cuid())
  participantId String?
  participant   Participant? @relation(fields: [participantId], references: [id], onDelete: SetNull)
  to            String
  type          String
  subject       String
  status        EmailStatus
  providerId    String?
  error         String?
  createdAt     DateTime     @default(now())

  @@index([participantId])
  @@index([type, createdAt])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
}

model Note {
  id            String      @id @default(cuid())
  participantId String
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  authorId      String
  author        User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body          String
  createdAt     DateTime    @default(now())

  @@index([participantId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  targetType String
  targetId   String
  meta       Json?
  ipHash     String?
  createdAt  DateTime @default(now())

  @@index([targetType, targetId])
  @@index([createdAt])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  ipHash    String?
  handled   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// Limiteur de débit applicatif (fenêtre fixe), hors routes d'authentification.
model Throttle {
  key     String   @id
  count   Int
  resetAt DateTime
}

/// Réglages modifiables par l'admin (ex. plafond de places).
model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
